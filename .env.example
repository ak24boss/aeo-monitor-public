# Required — get a key at firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# One OpenRouter key covers Perplexity sonar, Gemini, and ChatGPT search engines.
# Get a key at openrouter.ai. Leave blank to skip AI engine probes cleanly.
OPENROUTER_API_KEY=sk-or-your-key-here

# Google AI Overviews — uses ValueSERP (valueserp.com), ~$0.0006/search.
# Tracks what appears in the AI Overview box on google.com search results.
# Leave blank to skip Google AI Overview probes.
VALUESERP_KEY=your-valueserp-key-here

# Legacy alias — same value as OPENROUTER_API_KEY. Either one works.
# PERPLEXITY_API_KEY=
