# Required — get a key at firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# One OpenRouter key covers all AI engines (Perplexity sonar, Claude, GPT-4o-mini).
# Get a key at openrouter.ai. Leave blank to skip Phases 4 and 4A cleanly.
OPENROUTER_API_KEY=sk-or-your-key-here

# Legacy alias — same value as OPENROUTER_API_KEY. Either one works.
# PERPLEXITY_API_KEY=

# Optional overrides — use if you want a native key for a specific engine
# instead of routing through OpenRouter.
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
